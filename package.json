{
  "name": "ballai-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:admin": "pnpm --dir admin build",
    "validate:worker": "pnpm --dir worker validate",
    "test": "node --test tests/*.test.js",
    "validate:seo": "node --test tests/seo.test.js && pnpm build && pnpm --dir site-router typecheck && pnpm --dir site-router exec wrangler deploy --dry-run --outdir dist",
    "validate:phase2": "pnpm test && pnpm build && pnpm --dir admin validate && pnpm validate:worker",
    "validate:phase25": "pnpm validate:phase2",
    "validate:phase27": "pnpm validate:phase25 && pnpm validate:seo",
    "preview": "vite preview",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-oxlint": "~1.11.0",
    "globals": "^16.3.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.11.0",
    "vite": "^7.1.7"
  }
}
